{
  "name": "VoxPopuli",
  "description": "Lets get back the comment Section",
  "version": "1.0.0",
  "manifest_version": 3,

  "permissions": [],

  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "compiled/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ]
}
