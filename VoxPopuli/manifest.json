{
  "manifest_version": 3,
  "name": "My Extension",
  "version": "1.0",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/apps/background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/apps/content/ContentMain.tsx"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/entries/interior.html", "src/entries/exterior.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/entries/exterior.html"
  }
}
