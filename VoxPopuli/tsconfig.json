{
  "compilerOptions": {
    "target": "es2024",
    "module": "ESNext",
     "moduleResolution": "bundler", 
    "rootDir": "src",
    "noEmit": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ES2024"],
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
